{
  "name": "gemini-enterprise-eval-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start:no-auth": "ng serve",
    "start:auth": "concurrently \"tsx watch src/server/main.ts\" \"ng serve --configuration auth-development\"",
    "start": "npm run start:no-auth",
    "build:no-auth": "ng build",
    "build:auth": "ng build --configuration auth-production && tsc -p tsconfig.server.json",
    "build": "npm run build:no-auth",
    "test:frontend": "ng test",
    "test:server": "tsx node_modules/jasmine/bin/jasmine.js --config=jasmine.json",
    "test": "npm run test:frontend && npm run test:server"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "papaparse": "^5.7.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/trusted-types": "^2.0.7",
    "concurrently": "^10.0.7",
    "jasmine": "^5.1.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.1.2"
  }
}
